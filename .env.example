# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=trading_user
DB_PASSWORD=trading_pass
DB_NAME=trading
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5

# DNSE API
DNSE_BASE_URL=https://api.dnse.com.vn
DNSE_WS_URL=wss://api.dnse.com.vn/streaming-services
DNSE_EMAIL=your_email@example.com
DNSE_PASSWORD=your_password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# Scanner Settings
SCANNER_MIN_SCORE=7
SCANNER_MAX_SIGNALS_PER_DAY=20
SCANNER_BAR_CACHE_SIZE=200
SCANNER_UPDATE_INTERVAL=1m

# WebSocket
WS_RECONNECT_INTERVAL=5s
WS_MAX_RECONNECT_ATTEMPTS=10
WS_PING_INTERVAL=30s

# Portfolio Defaults
DEFAULT_MAX_POSITIONS=3
DEFAULT_RISK_PER_TRADE=0.02
DEFAULT_INITIAL_CAPITAL=100000000

# Notification Settings
DAILY_REPORT_TIME=08:00
TIMEZONE=Asia/Ho_Chi_Minh
NOTIFICATIONS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Application
APP_ENV=development
APP_PORT=8080

# ML Service (gRPC)
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=50055
ML_SERVICE_TIMEOUT=30s
